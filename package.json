{
  "name": "atenas-launcher",
  "productName": "Atenas Client",
  "version": "1.1.4",
  "description": "Launcher de Minecraft con modpacks propios y actualizaciones automáticas de mods",
  "main": "main.js",
  "author": "kaspercito",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/test-sync.js && node test/test-packsync.js && node test/test-ping.js && node test/test-loaders.js && node test/test-discord.js && node admin/test/test-modsfile.js && node admin/test/test-packs.js && node admin/test/test-curseforge.js",
    "manifest": "node tools/generate-manifest.js",
    "dist": "electron-builder --win --publish never",
    "pack": "node tools/pack-sync.js",
    "admin": "electron admin",
    "installer": "electron installer"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.atenas.launcher",
    "productName": "Atenas Client",
    "copyright": "Copyright © 2026 kaspercito",
    "artifactName": "Atenas-Client-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "launcher.config.json",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Atenas Client",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "language": "3082",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release",
      "owner": "kaspercito",
      "repo": "atenas-launcher"
    }
  }
}