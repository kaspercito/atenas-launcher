{
  "name": "atenas-launcher",
  "productName": "Atenas Launcher",
  "version": "1.0.2",
  "description": "Launcher de Minecraft con modpacks propios y actualizaciones automáticas de mods",
  "main": "main.js",
  "author": "Miguel Angel",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/test-sync.js && node test/test-packsync.js && node test/test-ping.js",
    "manifest": "node tools/generate-manifest.js",
    "dist": "electron-builder --win --publish never",
    "pack": "node tools/pack-sync.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.atenas.launcher",
    "productName": "Atenas Launcher",
    "files": [
      "main.js",
      "preload.js",
      "launcher.config.json",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Atenas Launcher"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release",
      "owner": "kaspercito",
      "repo": "atenas-launcher"
    }
  }
}
