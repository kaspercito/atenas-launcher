<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex"><title>Atenas · Panel de cosm&eacute;ticos</title>
<style>
:root{--bg:#0e0b16;--card:#181326;--line:#2c2342;--tx:#ece8f7;--mut:#9b92b5;--ac:#8b5cf6;--ok:#34d399;--er:#f87171}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.45 system-ui,Segoe UI,sans-serif}
header{display:flex;align-items:center;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line);background:#120e1d;position:sticky;top:0;z-index:5}
header h1{font-size:17px;margin:0;flex:1}main{max-width:1100px;margin:0 auto;padding:18px;display:grid;gap:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}h2{margin:0 0 12px;font-size:15px}
label{display:block;font-size:12px;color:var(--mut);margin:10px 0 4px}
input,select,button{font:inherit;color:var(--tx);background:#0f0b1a;border:1px solid var(--line);border-radius:8px;padding:8px 10px}
input[type=color]{padding:2px;height:36px;width:60px}input[type=file]{width:100%}input:not([type=checkbox]):not([type=color]),select{width:100%}
button{cursor:pointer;background:var(--ac);border-color:var(--ac);font-weight:600}button.sec{background:transparent;border-color:var(--line)}button.del{background:transparent;border-color:var(--er);color:var(--er)}
button:disabled{opacity:.5;cursor:default}.row{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}.chip{background:#251c3d;border:1px solid var(--line);border-radius:99px;padding:3px 6px 3px 10px;display:flex;gap:6px;align-items:center}
.chip b{cursor:pointer;color:var(--er)}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:8px;border-bottom:1px solid var(--line);vertical-align:middle}th{color:var(--mut);font-size:12px}
.tag{font-size:11px;border-radius:6px;padding:2px 6px;background:#251c3d}.tag.p{background:#3b1d2a;color:#fda4af}.tag.g{background:#12352b;color:#6ee7b7}
#msg{position:fixed;right:16px;bottom:16px;max-width:360px;padding:12px 14px;border-radius:10px;display:none;z-index:9}#msg.ok{background:#0f3a2c;border:1px solid var(--ok)}#msg.er{background:#3a1515;border:1px solid var(--er)}
.prev{display:flex;gap:12px;align-items:center;margin-top:8px}.prev canvas{background:repeating-conic-gradient(#222 0 25%,#2c2c2c 0 50%) 0 0/12px 12px;border-radius:6px;image-rendering:pixelated}
.hint{font-size:12px;color:var(--mut)}.sug{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}.sug button{background:transparent;border-color:var(--line);font-weight:400;padding:3px 8px}
#login{max-width:380px;margin:12vh auto}.hide{display:none!important}.grow{flex:1}
</style></head><body>
<div id="login" class="card"><h2>Panel de Atenas</h2>
<label>Clave de administrador</label><input id="key" type="password" autocomplete="off" placeholder="ADMIN_KEY del Worker">
<p class="hint">Es el secreto <code>ADMIN_KEY</code> que creaste con wrangler. Se guarda solo en esta pesta&ntilde;a.</p>
<button id="enter" style="margin-top:8px;width:100%">Entrar</button></div>

<div id="app" class="hide">
<header><h1>Atenas &middot; Cosm&eacute;ticos</h1><span class="hint" id="rev"></span><button class="sec" id="out">Salir</button></header>
<main>
<section class="card"><h2>Cosm&eacute;ticos y reglas actuales</h2>
<div style="overflow-x:auto"><table><thead><tr><th>Tipo</th><th>Id</th><th>Nombre</th><th>Clase</th><th>Acceso</th><th></th></tr></thead><tbody id="list"></tbody></table></div></section>

<section class="card"><h2 id="ftitle">Nuevo cosm&eacute;tico</h2>
<div class="row">
<div><label>Qu&eacute; quieres hacer</label><select id="mode"><option value="custom">Cosm&eacute;tico NUEVO (con textura)</option><option value="rule">Regla sobre uno que ya trae el mod (ej. Catalina)</option></select></div>
<div><label>Tipo</label><select id="type"><option value="cape">Capa</option><option value="wings">Alas</option><option value="hat">Sombrero</option><option value="pet">Mascota</option></select></div>
<div><label id="idlabel">Id (x_ + letras, n&uacute;meros o _)</label><input id="id" maxlength="24" placeholder="x_mi_capa"><div class="sug" id="idsug"></div></div>
<div><label>Nombre que ver&aacute;n</label><input id="name" maxlength="32" placeholder="Mi capa"></div>
</div>
<div id="customBox">
<div class="row">
<div><label>Modelo base (la forma que se reutiliza)</label><select id="base"></select><div class="hint" id="basehint"></div></div>
<div id="framesBox"><label>Capa animada</label><select id="frames"><option value="1">Normal (1 cuadro)</option><option value="12">Animada (12 cuadros)</option></select></div>
<div><label>Color en el men&uacute;</label><input id="color" type="color" value="#8b5cf6"></div>
<div><label>Brillo</label><label style="display:flex;gap:8px;align-items:center;margin:0;color:var(--tx)"><input id="glow" type="checkbox"> Brilla en la oscuridad</label></div>
</div>
<div class="row">
<div><label>Textura PNG (m&aacute;x. 1 MB)</label><input id="tex" type="file" accept="image/png"><div class="prev"><canvas id="texc" width="96" height="96"></canvas><span class="hint" id="texinfo">Sin textura nueva.</span></div></div>
<div><label>Icono 32x32 PNG</label><input id="icon" type="file" accept="image/png"><div class="prev"><canvas id="iconc" width="64" height="64"></canvas><span class="hint" id="iconinfo">Sin icono nuevo.</span></div>
<button class="sec" id="autoicon" style="margin-top:8px">Crear icono a partir de la textura</button></div>
</div></div>
<div class="row"><div><label>Qui&eacute;n lo puede usar</label><select id="scope"><option value="global">Todos</option><option value="private">Solo estos nicks</option></select></div></div>
<div id="ownersBox"><label>Nicks con acceso (sin distinguir may&uacute;sculas)</label>
<div style="display:flex;gap:8px"><input id="ownerin" placeholder="Escribe un nick y pulsa Enter, o busca entre quienes ya usaron Atenas" maxlength="16"><button class="sec" id="addowner">A&ntilde;adir</button></div>
<div class="sug" id="psug"></div><div class="chips" id="owners"></div></div>
<div style="display:flex;gap:10px;margin-top:16px"><button id="save">Guardar</button><button class="sec" id="reset">Limpiar formulario</button></div>
<p class="hint">Al guardar, los jugadores reciben el cambio en menos de un minuto (el cliente consulta el cat&aacute;logo cada 45 s). Si cambias la textura, se vuelve a descargar sola.</p>
</section></main></div><div id="msg"></div>

<script>
(function(){
'use strict';
var $=function(i){return document.getElementById(i)};
var BASES={
 cape:['atenas','arcoiris','atardecer','aurora','bosque','cosmos','creeper','cristal','dragon','eclipse','esmeralda','fuego','galaxia','hielo','lava','llamas','lluvia','luciernagas','mareas','matrix','neon','nieve','noche','oceano','oro','oroliquido','portal','pulso','sakura','tormenta','violeta'],
 wings:['feather','lunar','neon','hielo','atenas','fuego','ambar','demonio','esmeralda','doradas','oscuras','sakura','angel','aurora','dragon','dragonhielo','ender','murcielago','fantasma','mariposa','hada','abeja','cristal','elitros'],
 hat:['gorra','mago','cuernos','auriculares','corona','conejo','halo','gato','galera'],
 pet:['perro','husky','gato','zorro','catalina','gatonegro','dalmata']
};
var HINT={cape:'La capa usa solo la textura (la forma es siempre la misma). Si es animada, la imagen son 12 cuadros apilados.',wings:'"feather" = alas de plumas. Los otros ids son alas de membrana (dragon, murcielago...) y usan la hoja de esa ala.',hat:'Elige el sombrero cuya caja/forma quieres reutilizar.',pet:'Elige la mascota cuyo modelo quieres reutilizar (la textura debe seguir su mismo layout; mira las plantillas de textura).'};
var key=sessionStorage.getItem('atenas_admin_key')||'';var owners=[];var texB64=null,iconB64=null,editing=null,items=[];
function msg(t,ok){var m=$('msg');m.textContent=t;m.className=ok?'ok':'er';m.style.display='block';clearTimeout(msg.t);msg.t=setTimeout(function(){m.style.display='none'},ok?3500:7000)}
function api(path,body){return fetch(path,{method:'POST',headers:{'content-type':'application/json','x-admin-key':key},body:JSON.stringify(body||{})}).then(function(r){return r.json().catch(function(){return{ok:false,message:'Respuesta no valida'}})}).then(function(j){if(j&&j.ok===false||j&&j.error){var e=new Error(j.message||j.error||'Error');e.code=j.error;throw e}return j})}
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function hex(n){return '#'+('000000'+((n>>>0)&0xffffff).toString(16)).slice(-6)}
var TN={cape:'Capa',wings:'Alas',hat:'Sombrero',pet:'Mascota'};

function enter(){key=$('key').value||key;api('/admin/ping').then(function(){sessionStorage.setItem('atenas_admin_key',key);$('login').classList.add('hide');$('app').classList.remove('hide');refresh()}).catch(function(e){sessionStorage.removeItem('atenas_admin_key');msg(e.message,false)})}
$('enter').onclick=enter;$('key').onkeydown=function(e){if(e.key==='Enter')enter()};
$('out').onclick=function(){sessionStorage.removeItem('atenas_admin_key');location.reload()};
if(key){enter()}

function refresh(){return api('/admin/list').then(function(j){items=j.items||[];$('rev').textContent='rev '+j.rev;var tb=$('list');tb.innerHTML='';
 if(!items.length){tb.innerHTML='<tr><td colspan="6" class="hint">Todav\u00eda no hay nada.</td></tr>'}
 items.forEach(function(it){var tr=document.createElement('tr');
  var acc=it.scope==='private'?'<span class="tag p">Privado</span> '+esc((it.owners||[]).join(', ')||'(nadie)'):'<span class="tag g">Todos</span>';
  tr.innerHTML='<td>'+TN[it.type]+'</td><td><code>'+esc(it.id)+'</code></td><td>'+esc(it.name)+'</td><td>'+(it.custom?'Nuevo (base '+esc(it.base)+', v'+it.ver+')':'Regla')+'</td><td>'+acc+'</td><td style="white-space:nowrap"><button class="sec" data-e="1">Editar</button> <button class="del" data-d="1">Borrar</button></td>';
  tr.querySelector('[data-e]').onclick=function(){load(it)};
  tr.querySelector('[data-d]').onclick=function(){if(confirm('Borrar '+it.key+'? Se quita tambien a quienes lo llevan puesto.'))api('/admin/delete',{key:it.key}).then(function(){msg('Borrado',true);refresh()}).catch(function(e){msg(e.message,false)})};
  tb.appendChild(tr)})}).catch(function(e){msg(e.message,false)})}

function fillBases(){var t=$('type').value,s=$('base');s.innerHTML='';BASES[t].forEach(function(b){var o=document.createElement('option');o.value=b;o.textContent=b;s.appendChild(o)});$('basehint').textContent=HINT[t];$('framesBox').classList.toggle('hide',t!=='cape');$('base').parentNode.classList.toggle('hide',t==='cape'&&false);fillSug()}
function fillSug(){var box=$('idsug');box.innerHTML='';if($('mode').value!=='rule')return;BASES[$('type').value].filter(function(b){return b!=='feather'}).forEach(function(b){var x=document.createElement('button');x.textContent=b;x.onclick=function(){$('id').value=b;if(!$('name').value)$('name').value=b};box.appendChild(x)})}
function syncMode(){var rule=$('mode').value==='rule';$('customBox').classList.toggle('hide',rule);$('idlabel').textContent=rule?'Id del cosm\u00e9tico del mod (ej. catalina)':'Id (x_ + letras, n\u00fameros o _)';$('id').placeholder=rule?'catalina':'x_mi_capa';if(rule){$('scope').value='private'}fillSug();syncScope()}
function syncScope(){$('ownersBox').classList.toggle('hide',$('scope').value!=='private')}
$('mode').onchange=syncMode;$('type').onchange=fillBases;$('scope').onchange=syncScope;

function drawOwners(){var c=$('owners');c.innerHTML='';owners.forEach(function(n,i){var d=document.createElement('span');d.className='chip';d.innerHTML=esc(n)+' <b title="Quitar">&times;</b>';d.querySelector('b').onclick=function(){owners.splice(i,1);drawOwners()};c.appendChild(d)})}
function addOwner(n){n=String(n||$('ownerin').value).trim().toLowerCase().replace(/[^a-z0-9_]/g,'');if(n.length<3||n.length>16){msg('El nick debe tener entre 3 y 16 caracteres (letras, n\u00fameros o _).',false);return}if(owners.indexOf(n)<0)owners.push(n);$('ownerin').value='';drawOwners()}
$('addowner').onclick=function(){addOwner()};
var pt;$('ownerin').oninput=function(){clearTimeout(pt);pt=setTimeout(function(){api('/admin/players',{q:$('ownerin').value}).then(function(j){var b=$('psug');b.innerHTML='';(j.players||[]).slice(0,12).forEach(function(p){var x=document.createElement('button');x.textContent=p.name;x.onclick=function(){addOwner(p.name)};b.appendChild(x)})}).catch(function(){})},250)};
$('ownerin').onkeydown=function(e){if(e.key==='Enter'){e.preventDefault();addOwner()}};

function readFile(f){return new Promise(function(res,rej){var r=new FileReader();r.onload=function(){res(r.result)};r.onerror=function(){rej(new Error('No se pudo leer el archivo'))};r.readAsDataURL(f)})}
function showPng(canvas,dataUrl,info,label,cb){var im=new Image();im.onload=function(){var g=canvas.getContext('2d');g.imageSmoothingEnabled=false;g.clearRect(0,0,canvas.width,canvas.height);var s=Math.min(canvas.width/im.width,canvas.height/im.height);g.drawImage(im,0,0,im.width*s,im.height*s);info.textContent=label+im.width+'x'+im.height+' px';if(cb)cb(im)};im.onerror=function(){info.textContent='No se pudo mostrar la imagen'};im.src=dataUrl}
$('tex').onchange=function(){var f=this.files[0];if(!f)return;if(f.size>1000000){msg('La textura pesa mas de 1 MB.',false);this.value='';return}readFile(f).then(function(u){texB64=u.split(',')[1];showPng($('texc'),u,$('texinfo'),'Nueva: ')}).catch(function(e){msg(e.message,false)})};
$('icon').onchange=function(){var f=this.files[0];if(!f)return;readFile(f).then(function(u){var im=new Image();im.onload=function(){if(im.width!==32||im.height!==32){msg('El icono debe medir exactamente 32x32 (este mide '+im.width+'x'+im.height+'). Usa "Crear icono".',false);$('icon').value='';return}iconB64=u.split(',')[1];showPng($('iconc'),u,$('iconinfo'),'Nuevo: ')};im.src=u})};
$('autoicon').onclick=function(e){e.preventDefault();if(!texB64){msg('Primero elige la textura.',false);return}var im=new Image();im.onload=function(){var c=document.createElement('canvas');c.width=c.height=32;var g=c.getContext('2d');g.imageSmoothingEnabled=false;
 // recorta la zona mas util: para capas animadas o alas toma el cuadro entero; escala manteniendo proporcion
 var s=Math.min(32/im.width,32/im.height),w=im.width*s,h=im.height*s;g.drawImage(im,(32-w)/2,(32-h)/2,w,h);var u=c.toDataURL('image/png');iconB64=u.split(',')[1];showPng($('iconc'),u,$('iconinfo'),'Autom\u00e1tico: ')};im.src='data:image/png;base64,'+texB64};

function clearForm(){editing=null;$('ftitle').textContent='Nuevo cosm\u00e9tico';$('mode').value='custom';$('mode').disabled=false;$('type').disabled=false;$('id').disabled=false;$('id').value='';$('name').value='';$('color').value='#8b5cf6';$('glow').checked=false;$('frames').value='1';$('scope').value='global';owners=[];texB64=iconB64=null;$('tex').value='';$('icon').value='';$('texinfo').textContent='Sin textura nueva.';$('iconinfo').textContent='Sin icono nuevo.';$('texc').getContext('2d').clearRect(0,0,96,96);$('iconc').getContext('2d').clearRect(0,0,64,64);$('type').value='cape';fillBases();syncMode();drawOwners()}
$('reset').onclick=clearForm;
function load(it){clearForm();editing=it.key;$('ftitle').textContent='Editando '+it.key;$('mode').value=it.custom?'custom':'rule';$('type').value=it.type;fillBases();syncMode();$('mode').disabled=true;$('type').disabled=true;$('id').value=it.id;$('id').disabled=true;$('name').value=it.name;
 if(it.custom){$('base').value=it.base;$('color').value=hex(it.color);$('glow').checked=!!it.glow;$('frames').value=String(it.frames||1);$('texinfo').textContent='Se conserva la textura actual (v'+it.ver+'). Sube otra para reemplazarla.';$('iconinfo').textContent='Se conserva el icono actual.'}
 $('scope').value=it.scope;owners=(it.owners||[]).slice();syncScope();drawOwners();window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})}

$('save').onclick=function(){var rule=$('mode').value==='rule',id=$('id').value.trim().toLowerCase(),name=$('name').value.trim();
 if(!id){msg('Falta el id.',false);return}
 if(!rule&&id.indexOf('x_')!==0){msg('Los cosmeticos nuevos llevan un id que empieza por x_ (ej. x_mi_capa).',false);return}
 if(!rule&&!name){msg('Falta el nombre.',false);return}
 if($('scope').value==='private'&&!owners.length&&!confirm('No pusiste ningun nick: nadie podra usarlo. Guardar igual?'))return;
 var body={type:$('type').value,id:id,name:name||id,custom:!rule,scope:$('scope').value,owners:$('scope').value==='private'?owners:[]};
 if(!rule){body.base=$('type').value==='cape'?'atenas':$('base').value;body.frames=Number($('frames').value);body.color=parseInt('ff'+$('color').value.slice(1),16);body.glow=$('glow').checked;if(texB64)body.tex_b64=texB64;if(iconB64)body.icon_b64=iconB64;
  if(!editing&&(!texB64||!iconB64)){msg('Para un cosmetico nuevo hacen falta la textura y el icono (puedes crear el icono automatico).',false);return}}
 $('save').disabled=true;api('/admin/save',body).then(function(j){msg(j.removed?'Regla quitada: ahora es para todos.':'Guardado'+(j.ver?' (version '+j.ver+')':''),true);clearForm();refresh()}).catch(function(e){msg(e.message,false)}).then(function(){$('save').disabled=false})};
clearForm();
})();
</script></body></html>
